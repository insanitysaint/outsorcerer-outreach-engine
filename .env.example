# ===========================================================================
# Outreach Engine starter kit: copy this file to ".env" and fill it in.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac / Linux:         cp .env.example .env
# Then run:  docker compose up -d
# After any change to this file:  docker compose up -d --force-recreate
# NEVER commit .env (it is already in .gitignore).
# ===========================================================================

# ---- 1. SAFETY SWITCH ------------------------------------------------------
# true  = every "send" goes ONLY to TEST_ADDRESS and nothing is logged as sent. Start here.
# false = emails go to the real leads. Only flip this when you are ready.
TEST_MODE=true
# Your own address(es) for test sends. Several allowed, comma separated.
TEST_ADDRESS=you@example.com

# ---- 2. WHO THE EMAILS COME FROM -------------------------------------------
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Your Name
SENDER_ROLE=Founder
SENDER_COMPANY=Your Company
SENDER_WEBSITE=yourdomain.com
# One or two sentences: who you are and what you offer.
OFFER="I'm Your Name from Your Company. We build websites and apps for agencies, white-label, so you can say yes to more projects without hiring."
BOOKING_LINK=https://cal.com/your-name/15min
SUBJECT=The project you had to turn down
# Used in follow-up email 2: "<BRAND_NAME>'s basic services start from <STARTING_PRICE>"
BRAND_NAME=Your Company
STARTING_PRICE='$150'

# ---- 3. SENDING SERVER (SMTP) - needed to send anything --------------------
# Examples:  Zoho smtp.zoho.com 465 | Gmail smtp.gmail.com 465 (needs an app password) | Outlook smtp.office365.com 587
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=
# true for port 465, false for 587 (STARTTLS). Leave blank to guess from the port.
SMTP_SECURE=

# ---- 4. REPLY DETECTION (IMAP) - optional ----------------------------------
# Leave IMAP_HOST empty to switch reply detection off. Everything else still works.
# Same mailbox as above. IMAP_USER / IMAP_PASSWORD default to the SMTP ones when blank.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---- 5. PACING AND SCHEDULE (sensible defaults, change if you like) --------
DAILY_LIMIT=5
FOLLOW_UP_1_AFTER_DAYS=5
FOLLOW_UP_2_AFTER_DAYS=5
MAX_FOLLOWUPS_PER_DAY=10
# Only email a lead while their office is open (local time).
RESPECT_OFFICE_HOURS=true
OPEN_HOUR=9
WINDOW_HOURS=2
# Used when a lead has no location and the email domain gives no country hint.
DEFAULT_TZ=Asia/Dubai
# Your own timezone for the schedule triggers (sender runs weekdays at 11:00 in this zone).
TZ=UTC
# Host port for n8n
N8N_PORT=5678
