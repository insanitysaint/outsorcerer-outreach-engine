  {
   "parameters": {
    "jsCode": "\nconst mails = $('Replies - IMAP').all().map(i => i.json);\nconst sent = $('Replies - Parse Sent Log').all().map(i => String(i.json.email || '').toLowerCase()).filter(Boolean);\nconst sentEmails = new Set(sent), sentDomains = new Set(sent.map(e => e.split('@')[1]).filter(Boolean));\nconst old = $('Replies - Parse Store').first()?.json || {};\nconst doc = old.doc || old.data || {};\nlet store = Array.isArray(doc.replies) ? doc.replies : [];\nconst ids = new Set(store.map(x => x.id));\nconst clip = (t) => {\n  const lines = String(t || '').replace(/\\r/g, '').split('\\n'); const out = [];\n  for (const l of lines) { if (/^\\s*>/.test(l) || /^On .+wrote:\\s*$/i.test(l) || /^-{2,}\\s*Original Message/i.test(l) || /^From:\\s.+@/i.test(l)) break; out.push(l); }\n  return out.join('\\n').trim().slice(0, 1500);\n};\nlet added = 0;\nfor (const m of mails) {\n  const f = (m.from && m.from.value && m.from.value[0]) || {};\n  const from = String(f.address || '').toLowerCase(); if (!from) continue;\n  const dom = from.split('@')[1] || '';\n  if (!(sentEmails.has(from) || sentDomains.has(dom))) continue;\n  if (from === String((typeof $env !== 'undefined' && $env.SENDER_EMAIL) || '').toLowerCase()) continue;\n  const id = String(m.messageId || (from + '|' + (m.date || '') + '|' + (m.subject || '')));\n  if (ids.has(id)) continue; ids.add(id);\n  store.unshift({ id, from, name: f.name || '', subject: String(m.subject || '').slice(0, 200), date: m.date ? new Date(m.date).toISOString() : new Date().toISOString(), snippet: clip(m.text || m.textAsHtml) });\n  added++;\n}\nstore.sort((a, b) => String(b.date).localeCompare(String(a.date))); store = store.slice(0, 300);\nreturn [{ json: { str: JSON.stringify({ replies: store }), added } }];\n"
   },
